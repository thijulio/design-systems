{
  "name": "@thijulio/biome-css",
  "version": "0.0.4",
  "private": false,
  "type": "module",
  "exports": {
    "./biome.css": "./dist/biome.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node verify.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@thijulio/biome-tokens": "*",
    "@thijulio/core": "*"
  },
  "nx": {
    "name": "biome-css",
    "tags": [
      "scope:biome"
    ],
    "targets": {
      "build": {
        "command": "node {projectRoot}/build.mjs",
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      },
      "test": {
        "command": "node {projectRoot}/verify.mjs",
        "dependsOn": [
          "build"
        ],
        "cache": true
      }
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/thijulio/design-systems.git",
    "directory": "packages/biome/css"
  }
}
