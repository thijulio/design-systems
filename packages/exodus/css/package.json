{
  "name": "@thijulio/exodus-css",
  "version": "0.0.2",
  "private": false,
  "type": "module",
  "exports": {
    "./exodus.css": "./dist/exodus.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node verify.mjs"
  },
  "devDependencies": {
    "@thijulio/exodus-tokens": "*"
  },
  "nx": {
    "name": "exodus-css",
    "tags": [
      "scope:exodus"
    ],
    "targets": {
      "build": {
        "command": "node {projectRoot}/build.mjs",
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      },
      "test": {
        "command": "node {projectRoot}/verify.mjs",
        "dependsOn": [
          "build"
        ],
        "cache": true
      }
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/thijulio/design-systems.git",
    "directory": "packages/exodus/css"
  }
}
