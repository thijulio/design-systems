# @thijulio packages publish to (and are consumed from) GitHub Packages.
# Workspace packages still resolve locally; this only affects publish + external installs.
# Auth is supplied at publish time via the NODE_AUTH_TOKEN env var (never commit a token).
@thijulio:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
